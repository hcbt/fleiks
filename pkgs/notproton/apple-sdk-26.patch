@@ -0,0 +1,49 @@
+import Foundation
+
+enum SetupCommand {
+    static let flag = "--setup"
+
+    static func run() -> Never {
+        Task.detached { exit(await perform()) }
+        dispatchMain()
+    }
+
+    static func perform() async -> Int32 {
+        let output = Output()
+        do {
+            let result = try SteamInstaller.run(report: { output.say($0.label) })
+            output.say("NotProton successfully installed.")
+
+            if let install = CrossOverSource.discover().first(where: \.isUsable) {
+                let license = CrossOverLicense.check(crossOverRoot: install.crossOverRoot)
+                if license.licensed, RunnerStore.state() == .none {
+                    output.say("Setting up compatibility tool")
+                    _ = try RunnerSetup.run(from: install) { output.say($0.label) }
+                } else if !license.licensed, RunnerStore.state() == .none {
+                    output.say(license.detail)
+                }
+            }
+
+            let valve = try ValvePackageManifest.bundled()
+            let needsValve = valve.files.contains {
+                Digest.sha256IfPresent(SupportPaths.bridge.appending(path: $0.bridgePath)) != $0.sha256
+            }
+            if needsValve {
+                output.say("Downloading missing components")
+                _ = try await ValveFetcher.run { output.say($0.label) }
+            }
+
+            try SteamInstaller.finish(result)
+            return 0
+        } catch {
+            FileHandle.standardError.write(Data("\(error.localizedDescription)\n".utf8))
+            return 1
+        }
+    }
+
+    private final class Output: @unchecked Sendable {
+        func say(_ line: String) {
+            FileHandle.standardOutput.write(Data("\(line)\n".utf8))
+        }
+    }
+}
