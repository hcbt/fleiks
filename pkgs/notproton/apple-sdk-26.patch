diff -ruN a/app/Sources/NotProtonApp/Support/ResourceBundle.swift b/app/Sources/NotProtonApp/Support/ResourceBundle.swift
--- a/app/Sources/NotProtonApp/Support/ResourceBundle.swift	1970-01-01 03:00:00
+++ b/app/Sources/NotProtonApp/Support/ResourceBundle.swift	2026-10-25 16:53:34
@@ -0,0 +1,12 @@
+import Foundation
+
+enum ResourceBundle {
+    static var module: Bundle {
+        let name = "NotProtonApp_NotProtonApp"
+        if let url = Bundle.main.url(forResource: name, withExtension: "bundle"),
+           let bundle = Bundle(url: url) {
+            return bundle
+        }
+        return Bundle.main
+    }
+}
diff -ruN a/app/Sources/NotProtonApp/Support/SetupCommand.swift b/app/Sources/NotProtonApp/Support/SetupCommand.swift
--- a/app/Sources/NotProtonApp/Support/SetupCommand.swift	1970-01-01 03:00:00
+++ b/app/Sources/NotProtonApp/Support/SetupCommand.swift	2026-10-25 16:53:34
@@ -0,0 +1,95 @@
+import Foundation
+
+enum SetupCommand {
+    static let flag = "--setup"
+
+    static func run() -> Never {
+        Task.detached { exit(await perform()) }
+        dispatchMain()
+    }
+
+    static func perform() async -> Int32 {
+        let output = Output()
+        do {
+            let result = try SteamInstaller.run(report: { output.say($0.label) })
+            output.say("NotProton successfully installed.")
+
+            if let install = CrossOverSource.discover().first(where: \.isUsable) {
+                output.say("Setting up compatibility tool")
+                let build = try RunnerInstaller.clone(from: install)
+                _ = try RunnerSetup.prepare(
+                    build,
+                    license: { _ in
+                        CrossOverLicense.Status(
+                            licensed: true,
+                            detail: "setup does not require activation",
+                            diagnostic: "setup"
+                        )
+                    },
+                    report: { output.say($0.label) }
+                )
+                if let tool = build.tools.first(where: { $0.flavor == .rosetta }) ?? build.tools.first {
+                    try setDefaultCompatTool(tool.name)
+                    output.say("Default compatibility tool is \(tool.name).")
+                }
+            }
+
+            let valve = try ValvePackageManifest.bundled()
+            let needsValve = valve.files.contains {
+                Digest.sha256IfPresent(SupportPaths.bridge.appending(path: $0.bridgePath)) != $0.sha256
+            }
+            if needsValve {
+                output.say("Downloading missing components")
+                _ = try await ValveFetcher.run { output.say($0.label) }
+            }
+
+            try SteamInstaller.finish(result)
+            return 0
+        } catch {
+            FileHandle.standardError.write(Data("\(error.localizedDescription)\n".utf8))
+            return 1
+        }
+    }
+
+    // App id 0 is Steam's global default. Written only when Steam has not
+    // created config.vdf yet; an existing file is left alone.
+    private static func setDefaultCompatTool(_ name: String) throws {
+        let config = SupportPaths.Steam.userData.appending(path: "config/config.vdf")
+        let path = config.path(percentEncoded: false)
+        guard !FileManager.default.fileExists(atPath: path) else { return }
+        try FileManager.default.createDirectory(
+            at: config.deletingLastPathComponent(), withIntermediateDirectories: true
+        )
+        let text = """
+        "InstallConfigStore"
+        {
+        \t"Software"
+        \t{
+        \t\t"Valve"
+        \t\t{
+        \t\t\t"Steam"
+        \t\t\t{
+        \t\t\t\t"CompatToolMapping"
+        \t\t\t\t{
+        \t\t\t\t\t"0"
+        \t\t\t\t\t{
+        \t\t\t\t\t\t"name"\t\t"\(name)"
+        \t\t\t\t\t\t"config"\t\t""
+        \t\t\t\t\t\t"priority"\t\t"75"
+        \t\t\t\t\t}
+        \t\t\t\t}
+        \t\t\t}
+        \t\t}
+        \t}
+        }
+
+        """
+        try Data(text.utf8).write(to: config)
+    }
+
+    private final class Output: @unchecked Sendable {
+        func say(_ line: String) {
+            FileHandle.standardOutput.write(Data("\(line)\n".utf8))
+        }
+    }
+}
