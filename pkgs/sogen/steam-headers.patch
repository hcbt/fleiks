+    tu = cx.Index.create().parse("s.cpp", args=args, unsaved_files=[("s.cpp", src)],
+                                 options=cx.TranslationUnit.PARSE_SKIP_FUNCTION_BODIES)
+    errors = [str(d) for d in tu.diagnostics if d.severity >= cx.Diagnostic.Error]
+    if errors:
+        raise RuntimeError("Steam SDK parsing failed:\n" + "\n".join(errors))
+    return tu
 
 
